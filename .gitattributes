# fnOS 生命周期脚本在 Linux 上直接执行，必须保持 LF
* text=auto eol=lf

apps/*/packaging/fnOS/cmd/* text eol=lf
apps/*/packaging/fnOS/scripts/* text eol=lf
apps/*/packaging/fnOS/manifest text eol=lf
apps/*/packaging/fnOS/config/* text eol=lf
apps/*/packaging/fnOS/wizard/* text eol=lf
apps/*/packaging/fnOS/ui/config text eol=lf
*.sh text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
LICENSE text eol=lf

# 二进制不走转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text eol=lf
*.fpk binary
*.deb binary
